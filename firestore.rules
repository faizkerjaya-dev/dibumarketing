rules_version = '2';

// Firestore Security Rules — Dibu Marketing
// Ini lapisan keselamatan sebenar. UI hanya sorok butang; rules ini yang menyekat akses.
// Deploy: Firebase Console > Firestore Database > Rules > tampal fail ini > Publish.
//
// Role: admin, marketing_manager, content_manager, content_creator, creator_manager, viewer
// Profil pengguna: users/{uid} { roles: [...], active: true, staffId }

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(userPath()) && get(userPath()).data.get('active', true) == true; }
    function hasAny(roles) { return isActive() && get(userPath()).data.get('roles', []).hasAny(roles); }
    function isAdmin() { return hasAny(['admin']); }
    function managers() { return hasAny(['admin', 'marketing_manager']); }
    function contentEditors() { return hasAny(['admin', 'marketing_manager', 'content_manager']); }
    function creatorEditors() { return hasAny(['admin', 'marketing_manager', 'creator_manager']); }
    function staffReader() { return hasAny(['admin', 'marketing_manager', 'content_manager', 'creator_manager', 'viewer']); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function changes(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Kaunter kod (DBU-0001, CMP-0001...). Semua staf aktif boleh hantar idea, jadi kaunter
    // 'content' boleh dinaikkan oleh sesiapa yang aktif. Kaunter lain untuk pengurus sahaja.
    match /counters/{id} {
      allow read, write: if hasAny(['admin', 'marketing_manager', 'content_manager', 'creator_manager'])
        || (isActive() && id == 'content');
    }

    match /staff/{id} {
      allow read: if isActive();
      allow create, update: if managers();
      allow delete: if isAdmin();
    }

    // Content Creator hanya boleh baca content yang dia terlibat (assigneeUids),
    // dan hanya boleh ubah checklist + links.
    match /content/{id} {
      allow read: if staffReader() || (isActive() && request.auth.uid in resource.data.assigneeUids);
      // Staf lain boleh hantar idea sahaja: content tanpa tarikh terbit dan bukan slot.
      // Idea tidak boleh terbit tanpa tarikh, jadi ia selamat.
      allow create: if contentEditors()
        || (isActive()
            && request.resource.data.get('publishDate', '') == ''
            && request.resource.data.get('isSlot', false) == false
            && request.resource.data.get('publishUrl', '') == ''
            && request.resource.data.get('assigneeUids', []).hasOnly([request.auth.uid]));
      allow update: if managers()
        || (hasAny(['content_manager']) && !changes(['review']))
        || (isActive() && request.auth.uid in resource.data.assigneeUids && changedOnly(['checklist', 'links', 'updatedAt', 'updatedBy']));
      allow delete: if isAdmin();
    }

    // Staf hanya boleh kemas kini status / nota tugasan sendiri.
    match /tasks/{id} {
      allow read: if staffReader() || (isActive() && resource.data.staffUid == request.auth.uid);
      allow create, delete: if contentEditors();
      allow update: if contentEditors()
        || (isActive() && resource.data.staffUid == request.auth.uid
            && changedOnly(['status', 'notes', 'actualHours', 'completedAt', 'history', 'updatedAt', 'updatedBy']));
    }

    match /campaigns/{id} {
      allow read: if staffReader();
      allow create, update: if managers();
      allow delete: if isAdmin();
    }

    match /creators/{id} {
      allow read: if staffReader();
      allow create, update: if creatorEditors();
      allow delete: if isAdmin();
    }

    match /campaignCreators/{id} {
      allow read: if staffReader();
      allow write: if creatorEditors();
    }

    match /deliverables/{id} {
      allow read: if staffReader();
      allow write: if creatorEditors();
    }

    match /metrics/{id} {
      allow read: if staffReader();
      allow create: if hasAny(['admin', 'marketing_manager', 'content_manager', 'creator_manager']);
      allow update, delete: if isAdmin();
    }

    // Komen tidak boleh diedit. Content Creator hanya nampak & tulis komen yang dia termasuk dalam visibleUids.
    match /comments/{id} {
      allow read: if staffReader() || (isActive() && request.auth.uid in resource.data.visibleUids);
      allow create: if isActive()
        && request.resource.data.authorUid == request.auth.uid
        && (staffReader() || request.auth.uid in request.resource.data.visibleUids)
        && (request.resource.data.kind == 'comment' || hasAny(['admin', 'marketing_manager', 'creator_manager']));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Sasaran KPI bulanan (ID 'YYYY-MM'). Semua staf aktif boleh baca supaya Content Creator nampak KPI sendiri.
    match /kpiTargets/{id} {
      allow read: if isActive();
      allow write: if managers();
    }

    // Rekod bilangan pengikut akaun jenama (diisi manual).
    match /accountStats/{id} {
      allow read: if staffReader();
      allow create, update: if hasAny(['admin', 'marketing_manager', 'content_manager', 'creator_manager']);
      allow delete: if isAdmin();
    }

    // Link umum dalam Pustaka link (tidak berkait dengan content tertentu).
    match /libraryLinks/{id} {
      allow read: if isActive();
      allow create: if hasAny(['admin', 'marketing_manager', 'content_manager', 'creator_manager'])
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || (isActive() && resource.data.authorUid == request.auth.uid);
    }

    match /activity/{id} {
      allow read: if staffReader();
      allow create: if isActive() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isActive();
      allow update: if signedIn() && resource.data.toUid == request.auth.uid && changedOnly(['read']);
      allow delete: if signedIn() && resource.data.toUid == request.auth.uid;
    }
  }
}
